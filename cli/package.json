{
  "name": "@idconnectdk/idc365-decisions",
  "version": "0.1.0",
  "description": "Agent-first CLI for the idc365-decisions documentation repository.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "idc365-decisions": "dist/index.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idconnectdk/idc365-decisions.git",
    "directory": "cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=2 \"build-test/test/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"build-test/test/integration/*.itest.js\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "marked": "18.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
